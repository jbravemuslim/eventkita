# Contoh konfigurasi EventKita.
# Salin jadi .env di mesin lokal (JANGAN di-commit .env asli).

# --- Database (PostgreSQL) ---
POSTGRES_DB=eventkita
POSTGRES_USER=eventkita
POSTGRES_PASSWORD=ganti-password-database
# DATABASE_URL dipakai container API (isi otomatis oleh compose/CapRover)
# DATABASE_URL=postgresql://eventkita:password@srv-captain--eventkita-db:5432/eventkita?schema=public

# --- Aplikasi ---
APP_DOMAIN=:80
APP_ORIGIN=http://localhost
JWT_SECRET=ganti-dengan-random-minimal-32-karakter
COOKIE_NAME=eventkita_session
COOKIE_SECURE=false
PORT=4000

# --- Seed admin (dipakai sekali saat inisialisasi DB) ---
SEED_ADMIN_NAME=Admin EventKita
SEED_ADMIN_EMAIL=admin@eventkita.local
SEED_ADMIN_PASSWORD=Admin12345!

# --- Mailer (e-ticket QR) ---
#mode dev: mailpit (docker compose -f docker-compose.dev.yml)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=EventKita <no-reply@eventkita.local>
# mode produksi (lab): mail server internal
# SMTP_HOST=mail.jehanbravemuslim.com
# SMTP_PORT=465
# SMTP_USER=eventkita@jehanbravemuslim.com
# SMTP_PASS=password-akun-mail
# SMTP_SECURE=true
# SMTP_TLS_REJECT_UNAUTHORIZED=false   # CA lab bersifat self-signed
