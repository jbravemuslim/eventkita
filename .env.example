# Template environment EventKita untuk production di Dokploy.
#
# JANGAN commit file .env asli. Salin nilai yang relevan ke tab
# Environment di Dokploy, bukan ke repository.
#
# Nilai CHANGE_ME di bawah hanya placeholder agar `docker compose config`
# bisa divalidasi. Ganti semuanya dengan nilai asli sebelum deploy.

# --- Database (PostgreSQL container) ---
POSTGRES_DB=eventkita
POSTGRES_USER=eventkita
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# Host `db` adalah nama service Compose. Password di URL ini harus sama
# dengan POSTGRES_PASSWORD. Gunakan karakter URL-safe atau URL-encode
# karakter khusus (mis. @ -> %40, # -> %23, $ -> %24).
DATABASE_URL=postgresql://eventkita:CHANGE_ME_DB_PASSWORD@db:5432/eventkita?schema=public

# --- Aplikasi ---
# URL publik aplikasi, tanpa trailing slash. Dipakai untuk link tiket.
APP_ORIGIN=https://eventkita.example.com
JWT_SECRET=CHANGE_ME_OPENSSL_RAND_BASE64_48
COOKIE_NAME=eventkita_session
# Wajib true di production HTTPS (Cloudflare Tunnel).
COOKIE_SECURE=true
PORT=4000

# --- Seed manual (tidak dijalankan otomatis saat deploy) ---
SEED_ADMIN_NAME=Admin EventKita
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# Opsional: kosongkan SEED_STAFF_PASSWORD jika tidak ingin membuat akun staff.
SEED_STAFF_NAME=Staff Check-in
SEED_STAFF_EMAIL=staff@example.com
SEED_STAFF_PASSWORD=

# --- Mailer production (Mailpit hanya untuk development) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME_SMTP_USER
SMTP_PASS=CHANGE_ME_SMTP_PASS
SMTP_FROM="EventKita <no-reply@example.com>"
# false untuk port 587/STARTTLS, true untuk port 465 (implicit TLS).
SMTP_SECURE=false
# false hanya jika memakai CA self-signed di lab.
SMTP_TLS_REJECT_UNAUTHORIZED=true

# --- Opsional/legacy ---
# Same-origin via rewrite Next.js tidak membutuhkan CORS.
# WEB_ORIGIN=https://eventkita.example.com
# APP_DOMAIN hanya untuk docker-compose.yml lama (Caddy).
# APP_DOMAIN=eventkita.example.com
