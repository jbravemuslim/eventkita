{
  "name": "eventkita",
  "version": "0.1.0",
  "private": true,
  "description": "Platform pendaftaran dan event ticketing komunitas",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "predev": "npm run build -w @eventkita/shared",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @eventkita/api\" \"npm run dev -w @eventkita/web\"",
    "predev:api": "npm run build -w @eventkita/shared",
    "dev:api": "npm run dev -w @eventkita/api",
    "predev:web": "npm run build -w @eventkita/shared",
    "dev:web": "npm run dev -w @eventkita/web",
    "build": "npm run build -w @eventkita/shared && npm run build -w @eventkita/api && npm run build -w @eventkita/web",
    "pretypecheck": "npm run build -w @eventkita/shared",
    "typecheck": "npm run typecheck -w @eventkita/shared && npm run typecheck -w @eventkita/api && npm run typecheck -w @eventkita/web",
    "db:generate": "npm run db:generate -w @eventkita/api",
    "db:migrate": "npm run db:migrate -w @eventkita/api",
    "db:deploy": "npm run db:deploy -w @eventkita/api",
    "db:seed": "npm run db:seed -w @eventkita/api",
    "db:studio": "npm run db:studio -w @eventkita/api",
    "test:smoke": "node scripts/smoke-test.mjs",
    "docker:dev": "docker compose -f docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:prod": "docker compose up -d --build",
    "docker:prod:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  },
  "engines": {
    "node": ">=20.11"
  }
}
