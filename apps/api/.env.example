# Environment development lokal (bukan untuk production).
# Salin ke apps/api/.env lalu sesuaikan.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://eventkita:eventkita@localhost:5432/eventkita?schema=public
JWT_SECRET=dev-secret-ganti-di-production-minimal-32-karakter
COOKIE_NAME=eventkita_session
COOKIE_SECURE=false
UPLOAD_DIR=./uploads
APP_ORIGIN=http://localhost:3000

# Opsional/legacy. Same-origin via rewrite Next.js tidak membutuhkan CORS.
# WEB_ORIGIN=http://localhost:3000

# Seed development. JANGAN pakai password ini di production.
SEED_ADMIN_NAME=Admin EventKita
SEED_ADMIN_EMAIL=admin@eventkita.local
SEED_ADMIN_PASSWORD=Admin12345!

SEED_STAFF_NAME=Staff Check-in
SEED_STAFF_EMAIL=staff@eventkita.local
SEED_STAFF_PASSWORD=Staff12345!

# Mailpit lokal (docker-compose.dev.yml mem-publish port 1025/8025).
# Jalankan API dari host, jadi host-nya localhost (bukan nama service mailpit).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=EventKita <no-reply@eventkita.local>
SMTP_SECURE=false
SMTP_TLS_REJECT_UNAUTHORIZED=true
